---
// Pannes traitées + déroulé d'une intervention.
import Deroule from '../Deroule.astro';

const pannes = [
  { titre: 'Panne de courant', texte: 'Plus de courant dans tout le logement ou dans une seule pièce.' },
  { titre: 'Disjoncteur qui saute', texte: 'Le courant se coupe tout seul, encore et encore.' },
  { titre: 'Prise ou interrupteur qui ne marche plus', texte: 'Une prise qui ne marche plus, qui chauffe ou qui fait de petits bruits.' },
  { titre: 'Lumière en panne', texte: "Une lampe, ou toutes les lumières d'une pièce, qui ne s'allument plus." },
  { titre: 'Tableau électrique', texte: 'Un tableau trop vieux, un disjoncteur abîmé, un problème à trouver.' },
  { titre: 'Panne inconnue', texte: "Vous ne savez pas d'où vient la panne ? Je la trouve et je vous explique." },
];

const etapes = [
  'Vous m’appelez ou m’écrivez sur WhatsApp en décrivant la panne.',
  'Je viens trouver la panne : 89 €, déplacement compris dans tout Avignon.',
  'Petite panne : je répare dans l’heure, vous payez seulement les pièces en plus. Sinon, je vous donne un devis gratuit (le prix écrit à l’avance) et je ne répare qu’avec votre accord.',
  'Je répare, je vous explique ce que j’ai fait et je vous remets la facture.',
];
---

<section class="section" aria-labelledby="pannes-titre">
  <div class="conteneur">
    <span class="surtitre">Les pannes que je traite</span>
    <h2 id="pannes-titre">Une panne électrique ? Je trouve d'où elle vient</h2>
    <ul class="liste-nue pannes" role="list">
      {
        pannes.map(({ titre, texte }) => (
          <li class="carte">
            <h3>{titre}</h3>
            <p>{texte}</p>
          </li>
        ))
      }
    </ul>

    <Deroule titre="Comment se passe une intervention" etapes={etapes} />
  </div>
</section>

<style>
  .pannes {
    display: grid;
    gap: 1rem;
    margin-block: 2rem 3rem;
  }

  .pannes h3 {
    font-size: 1.125rem;
  }

  @media (min-width: 40rem) {
    .pannes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .pannes {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
