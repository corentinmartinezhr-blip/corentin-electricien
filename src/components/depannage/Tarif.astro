---
// Tarif du dépannage : 65 € TTC de l'heure, déplacement et devis gratuits, et les
// mentions obligatoires (arrêté du 24 janvier 2017 : taux horaire, déplacement, décompte du temps).
// L'exemple est mis en avant sous la carte : c'est lui qui rend le tarif évident. Données : src/data/tarifs.ts.
import GrilleTarifs from '../GrilleTarifs.astro';
import { offreDepannage } from '../../data/tarifs';
---

<section class="section" id="tarifs" aria-labelledby="tarifs-titre">
  <div class="conteneur">
    <h2 id="tarifs-titre">Tarifs</h2>
    <div class="tarif">
      <div class="carte offre">
        <p class="offre__prix">{offreDepannage.prix} <span>{offreDepannage.unite}</span></p>
        <h3>{offreDepannage.titre}</h3>
        <ul class="offre__inclus">
          {[...offreDepannage.inclus, offreDepannage.promesse].map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <GrilleTarifs titre="Selon le moment (TTC)" lignes={offreDepannage.horaires} />
    </div>
    <div class="fond-olive exemple">
      <p class="exemple__titre">Exemple</p>
      <p class="exemple__situation">{offreDepannage.exemple.situation}</p>
      <p class="exemple__prix">= {offreDepannage.exemple.prix}</p>
    </div>
  </div>
</section>

<style>
  .tarif {
    display: grid;
    align-items: start;
    gap: 1rem;
    margin-block: 1.5rem 1rem;
  }

  .offre {
    border-top: 4px solid var(--jaune-soleil);
  }

  .offre .offre__prix {
    margin-block: 0 0.5rem;
    color: var(--vert-olive);
    font-family: var(--font-titre);
    font-size: clamp(2.5rem, 8vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
  }

  .offre__prix span {
    font-family: var(--font-texte);
    font-size: 1.25rem;
  }

  .offre__inclus {
    margin: 0;
    padding-left: 1.2rem;
  }

  .offre__inclus li + li {
    margin-top: 0.35rem;
  }

  /* Dernière ligne = la promesse « pas de facturation si je ne trouve pas la panne » : mise en avant. */
  .offre__inclus li:last-child {
    font-weight: 700;
  }

  /* Exemple chiffré : bandeau olive, le prix en jaune (le jaune est permis sur fond foncé). */
  .exemple {
    padding: 1.5rem;
    border-radius: var(--rayon);
  }

  .exemple p {
    margin: 0;
  }

  .exemple__titre {
    color: var(--jaune-soleil);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .exemple .exemple__situation {
    margin-top: 0.35rem;
    font-size: 1.125rem;
  }

  .exemple .exemple__prix {
    margin-top: 0.25rem;
    color: var(--jaune-soleil);
    font-family: var(--font-titre);
    font-size: clamp(1.5rem, 4.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
  }

  @media (min-width: 48rem) {
    .tarif {
      grid-template-columns: 1.2fr 1fr;
      gap: 1.5rem;
    }

    .exemple {
      padding: 1.75rem 2rem;
    }
  }
</style>
