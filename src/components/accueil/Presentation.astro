---
import { entreprise } from '../../data/entreprise';

// Faits et valeurs fournis par Corentin (29/10/2026, complétés le 14/11/2026 : écologie, réparation, matériel
// durable et réparable, pas de gadgets). N'ajouter que du vérifié.
// L'écologie est dite comme une conviction de Corentin, avec des faits (vélo, réparation) : jamais comme une
// qualité du service (« écologique », « zéro émission » : allégations encadrées par la loi).
const valeurs = [
  {
    titre: 'Réactif, clair et honnête',
    texte: "Vous m'appelez et c'est moi qui réponds, pas un standard. Je vous explique ce que je vois et ce que je propose, avec des mots simples.",
  },
  {
    titre: 'À vélo électrique',
    texte: "L'écologie me tient à cœur : c'est pour ça que je me déplace à vélo électrique. Pas de voiture, pas de bouchons, pas de problème pour me garer.",
  },
  {
    titre: 'Réparer avant de remplacer',
    texte: 'Je cherche d’abord à réparer et à garder ce qui marche encore chez vous. Je ne change une pièce que si c’est nécessaire.',
  },
  {
    titre: 'Du solide, qui se répare',
    texte: 'Je pose du matériel de bonne qualité, qui dure longtemps et qu’on pourra réparer plus tard. Pas de gadgets.',
  },
  { titre: 'Travail fait main', texte: 'Je suis artisan : je fais chaque travail moi-même, avec soin.' },
];
---

<section class="section section--brume" aria-labelledby="presentation-titre">
  <div class="conteneur presentation">
    <div>
      <span class="surtitre">Qui suis-je</span>
      <h2 id="presentation-titre">Un artisan, une seule personne à qui parler</h2>
      <p>
        Je m'appelle Corentin, j'ai 31 ans et je suis électricien indépendant à {entreprise.ville}. Quand vous
        m'appelez, c'est moi qui vous réponds et c'est moi qui interviens.
      </p>
      <p>
        Ce qui compte pour moi : vous parler clairement et tout vous dire. Je prends le temps de vous expliquer
        ce qui se passe et ce qu'on peut faire, avec des mots simples.
      </p>
    </div>
    <ul class="liste-nue valeurs" role="list">
      {
        valeurs.map((valeur) => (
          <li class="valeur">
            <h3>{valeur.titre}</h3>
            <p>{valeur.texte}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .presentation {
    display: grid;
    gap: 2rem;
  }

  .valeurs {
    display: grid;
    align-content: center;
    gap: 1.25rem;
  }

  .valeur {
    padding-left: 1rem;
    border-left: 3px solid var(--jaune-soleil);
  }

  .valeur h3 {
    margin-bottom: 0.25rem;
    font-size: 1.125rem;
  }

  .valeur p {
    margin: 0;
    color: var(--gris-pierre);
  }

  @media (min-width: 48rem) {
    .presentation {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
  }
</style>
