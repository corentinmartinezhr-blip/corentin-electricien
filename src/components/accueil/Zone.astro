---
import { communes, entreprise } from '../../data/entreprise';
---

<section class="section section--brume" aria-labelledby="zone-titre">
  <div class="conteneur">
    <span class="surtitre">Zone d'intervention</span>
    <h2 id="zone-titre">{entreprise.ville} et les villes proches</h2>
    <p class="intro">
      Je me déplace gratuitement, {entreprise.deplacement}, dans ces quatre villes. J'arrive {entreprise.delai}.
    </p>
    <ul class="liste-nue etiquettes communes" role="list">
      {communes.map((commune) => <li>{commune}</li>)}
    </ul>
  </div>
</section>

<style>
  .communes {
    margin-top: 1.75rem;
  }
</style>
