---
// FAQ de l'accueil : questions générales. Les questions de pannes (courant, disjoncteur…) sont sur la
// page Dépannage (FaqUrgence), pour ne pas avoir deux fois le même texte aux yeux de Google.
import ListeQuestions from '../ListeQuestions.astro';
import NumeroCopiable from '../NumeroCopiable.astro';

// Question « Réparez-vous l'électroménager ? » mise de côté le 28/11/2026 (voir docs/de-cote.md).
const questions: { question: string; reponse: string }[] = [];
---

<section class="section section--brume" aria-labelledby="faq-titre">
  <div class="conteneur">
    <span class="surtitre">Questions fréquentes</span>
    <h2 id="faq-titre">Vos questions</h2>
    <ListeQuestions questions={questions}>
      <details>
        <summary>Comment vous contacter ?</summary>
        <p>
          Par téléphone ou sur WhatsApp, au <NumeroCopiable />, ou par le <a href="/contact/">formulaire de contact</a>.
          Vous tombez directement sur moi.
        </p>
      </details>
    </ListeQuestions>
    <p class="faq__suite">
      Une panne de courant, un disjoncteur qui saute&nbsp;? Les réponses sont sur la page
      <a href="/depannage-electrique-avignon/#questions">dépannage d'urgence</a>.
    </p>
  </div>
</section>

<style>
  .faq__suite {
    margin: 1.5rem 0 0;
  }
</style>
