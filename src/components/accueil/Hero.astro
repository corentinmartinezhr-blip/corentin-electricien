---
import BoutonContact from '../BoutonContact.astro';
import { entreprise } from '../../data/entreprise';
---

<section class="hero" aria-labelledby="hero-titre">
  <div class="conteneur hero__grille">
    <div>
      <span class="surtitre">Électricien d'urgence à {entreprise.ville}</span>
      <h1 id="hero-titre">Un problème électrique&nbsp;? Je suis là pour vous aider.</h1>
      <p class="hero__accroche">
        Plus de courant, un disjoncteur qui saute, un appareil qui ne marche plus ? J'arrive
        {entreprise.deplacement}, {entreprise.delai}. {entreprise.horaires}.
      </p>
      <div class="hero__actions">
        <BoutonContact action="appel" variante="principal" class="action--appel" />
        <BoutonContact action="devis" class="action--devis" />
        <BoutonContact action="whatsapp" class="action--whatsapp" />
      </div>
    </div>
    <!-- WebP retouché et compressé par Corentin, servi tel quel (pas de recompression). 1086 × 1448. -->
    <img
      class="hero__photo"
      src="/portrait/corentin.webp"
      alt={`Corentin, artisan électricien à ${entreprise.ville}`}
      width="1086"
      height="1448"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem);
    background: var(--vert-brume);
  }

  .hero__grille {
    display: grid;
    align-items: center;
    gap: 2.5rem;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2rem, 6vw, 3.25rem);
  }

  .hero__accroche {
    max-width: 36rem;
    margin-bottom: 1.75rem;
    font-size: 1.125rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Ordre des boutons sur mobile : Appeler, WhatsApp, devis. */
  .hero__actions :global(.action--appel) {
    order: 1;
  }
  .hero__actions :global(.action--whatsapp) {
    order: 2;
  }
  .hero__actions :global(.action--devis) {
    order: 3;
  }

  .hero__photo {
    justify-self: center;
    width: min(20rem, 80vw);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 1.25rem;
  }

  @media (max-width: 29.99rem) {
    .hero__actions :global(.bouton) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 48rem) {
    .hero__grille {
      grid-template-columns: 1.3fr 0.7fr;
      gap: 3rem;
    }

    .hero__photo {
      justify-self: end;
      width: 100%;
      max-width: 24rem;
    }

    /* Ordre sur ordinateur : Appeler, devis, WhatsApp. */
    .hero__actions :global(.action--devis) {
      order: 2;
    }
    .hero__actions :global(.action--whatsapp) {
      order: 3;
    }
  }
</style>
