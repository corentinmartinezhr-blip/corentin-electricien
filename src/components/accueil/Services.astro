---
import Icone from '../Icone.astro';

// Chaque carte renvoie vers sa page dédiée.
const services = [
  {
    icone: 'eclair',
    titre: 'Dépannage électrique',
    texte:
      "Plus de courant, un disjoncteur qui saute, une prise ou une lumière qui ne marche plus : je trouve d'où vient la panne et je la répare.",
    lien: { url: '/depannage-electrique-avignon/', texte: 'Dépannage et tarifs' },
  },
  {
    icone: 'outils',
    titre: 'Petits travaux et tableau',
    texte:
      "J'ajoute ou je change vos prises et vos interrupteurs, j'installe vos lampes et je m'occupe de votre tableau électrique.",
    lien: { url: '/installation-electrique-avignon/', texte: 'Réalisations et tarifs' },
  },
  {
    icone: 'electromenager',
    titre: 'Électroménager',
    texte: 'Votre lave-linge, votre four ou votre lave-vaisselle ne marche plus ? Je trouve ce qui ne va pas et je le répare.',
    lien: { url: '/depannage-electrique-avignon/#electromenager', texte: 'Électroménager et tarif' },
  },
] as const;
---

<section class="section" aria-labelledby="services-titre">
  <div class="conteneur">
    <span class="surtitre">Mes services</span>
    <h2 id="services-titre">Ce que je fais pour vous</h2>
    <ul class="liste-nue services" role="list">
      {
        services.map((service) => (
          <li class="carte service">
            <span class="pastille-icone">
              <Icone nom={service.icone} taille={24} />
            </span>
            <h3>{service.titre}</h3>
            <p>{service.texte}</p>
            <a class="service__lien" href={service.lien.url}>
              {service.lien.texte} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  /* Les liens s'alignent en bas des cartes, quelle que soit la longueur du texte. */
  .service {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service__lien {
    margin-top: auto;
    padding-top: 1rem;
    font-weight: 700;
    text-decoration-color: var(--jaune-soleil);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (min-width: 48rem) {
    .services {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
