---
// Numéro écrit en clair : un clic le COPIE (avec un petit message « Numéro copié »).
// Les boutons « Appeler » gardent, eux, le lien tel: qui lance l'appel.
// Demande de Corentin du 29/10/2026.
import { entreprise } from '../data/entreprise';

interface Props {
  class?: string;
}
const { class: classe } = Astro.props;
---

<button
  type="button"
  class:list={['numero-copiable', classe]}
  data-copier={entreprise.telephoneAffiche}
  aria-label={`${entreprise.telephoneAffiche}, copier le numéro`}
>
  {entreprise.telephoneAffiche}
</button>

<style is:global>
  .numero-copiable {
    position: relative;
    display: inline;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    cursor: copy;
    -webkit-user-select: text;
    user-select: text;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .numero-copiable__message {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.4rem);
    transform: translate(-50%, 0.25rem);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--vert-olive);
    color: var(--ivoire);
    font-family: var(--font-texte);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: normal;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .numero-copiable__message.est-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* Sur fond olive, le message passe en jaune pour rester visible. */
  .numero-copiable--sur-olive .numero-copiable__message {
    background: var(--jaune-soleil);
    color: var(--vert-olive);
  }
</style>

<script>
  // 1) Copie « classique », synchrone dans le geste de l'utilisateur : la plus fiable
  //    (Android, navigateurs intégrés, iOS avec le réglage de sélection ci-dessous).
  function copieClassique(texte: string): boolean {
    const zone = document.createElement('textarea');
    zone.value = texte;
    zone.setAttribute('aria-hidden', 'true');
    zone.style.position = 'fixed';
    zone.style.top = '0';
    zone.style.left = '0';
    zone.style.opacity = '0';
    zone.style.fontSize = '16px'; // évite le zoom automatique sur iPhone
    zone.contentEditable = 'true';
    document.body.appendChild(zone);
    zone.focus();
    zone.select();
    zone.setSelectionRange(0, texte.length); // nécessaire sur iOS
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    zone.remove();
    return ok;
  }

  // 2) Sinon, l'API moderne du presse-papiers.
  function copier(texte: string): Promise<void> {
    if (copieClassique(texte)) return Promise.resolve();
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(texte);
    }
    return Promise.reject(new Error('copie impossible'));
  }

  document.addEventListener('click', (evenement) => {
    const bouton = (evenement.target as Element | null)?.closest<HTMLButtonElement>('.numero-copiable');
    if (!bouton) return;
    const numero = bouton.dataset.copier ?? '';
    copier(numero)
      .then(() => afficher(bouton, 'Numéro copié'))
      .catch(() => {
        // Dernier recours : on sélectionne le numéro pour un appui long « Copier ».
        const selection = window.getSelection();
        const plage = document.createRange();
        plage.selectNodeContents(bouton.firstChild ?? bouton);
        selection?.removeAllRanges();
        selection?.addRange(plage);
        afficher(bouton, 'Appui long pour copier');
      });
  });

  function afficher(bouton: HTMLButtonElement, texte: string) {
    let message = bouton.querySelector<HTMLSpanElement>('.numero-copiable__message');
    if (!message) {
      message = document.createElement('span');
      message.className = 'numero-copiable__message';
      message.setAttribute('role', 'status');
      bouton.appendChild(message);
    }
    message.textContent = texte;
    requestAnimationFrame(() => message!.classList.add('est-visible'));
    window.clearTimeout(Number(message.dataset.minuteur));
    message.dataset.minuteur = String(
      window.setTimeout(() => message!.classList.remove('est-visible'), 1800),
    );
  }
</script>
