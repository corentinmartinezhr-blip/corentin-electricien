---
// Numéro écrit en clair : un clic le copie et affiche « Numéro copié » (script : src/scripts/contact.ts).
// Demande de Corentin du 29/10/2026.
import { entreprise } from '../data/entreprise';

interface Props {
  class?: string;
}

const { class: classe } = Astro.props;
---

<button
  type="button"
  class:list={['numero-copiable', classe]}
  data-copier={entreprise.telephoneAffiche}
  aria-label={`${entreprise.telephoneAffiche}, copier le numéro`}
>
  {entreprise.telephoneAffiche}
</button>

<style>
  .numero-copiable {
    position: relative;
    display: inline;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    cursor: copy;
    -webkit-user-select: text;
    user-select: text;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
