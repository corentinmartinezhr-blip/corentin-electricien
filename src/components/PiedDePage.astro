---
import NumeroCopiable from './NumeroCopiable.astro';
import { entreprise } from '../data/entreprise';
import { menu } from '../data/navigation';

const annee = new Date().getFullYear();
---

<footer class="fond-olive pied">
  <div class="conteneur pied__ligne">
    <img
      class="pied__logo"
      src="/logo/logo-horizontal-fond-olive.svg"
      alt={entreprise.nom}
      width="1188"
      height="500"
      loading="lazy"
    />
    <div class="pied__infos">
      <p>
        Électricien à {entreprise.ville} et dans les communes voisines<br />
        <NumeroCopiable />
      </p>
      <nav class="pied__nav" aria-label="Pages du site">
        <a href="/">Accueil</a>
        {menu.map(({ url, texte }) => <a href={url}>{texte}</a>)}
      </nav>
      <p class="pied__copyright">© {annee} {entreprise.nom}</p>
    </div>
  </div>
</footer>

<style>
  .pied {
    padding-block: 2.5rem;
    border-top: 1px solid var(--bordure-claire);
  }

  .pied__ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .pied__logo {
    width: 11rem;
  }

  .pied__infos {
    font-size: 0.9375rem;
  }

  .pied__infos p {
    margin: 0 0 0.5rem;
  }

  .pied__infos :global(.numero-copiable) {
    text-decoration-color: var(--jaune-soleil);
  }

  .pied__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 0.5rem;
  }

  .pied__copyright {
    opacity: 0.75;
  }

  @media (min-width: 48rem) {
    .pied__infos {
      text-align: right;
    }

    .pied__nav {
      justify-content: flex-end;
    }
  }
</style>
