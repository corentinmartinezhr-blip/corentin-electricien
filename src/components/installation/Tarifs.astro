---
// Tarifs de l'installation (offre de lancement) : 65 € de l'heure, matériel en plus, déplacement et devis
// gratuits. La règle est dite une seule fois, puis chaque intervention affiche son temps estimé.
// Données : src/data/tarifs.ts.
import GrilleTarifs from '../GrilleTarifs.astro';
import Icone from '../Icone.astro';
import { decompteTemps, interventionsInstallation, mentionTva, offreLancement, tauxInstallation } from '../../data/tarifs';
---

<section class="section section--brume" id="tarifs" aria-labelledby="tarifs-titre">
  <div class="conteneur">
    <h2 id="tarifs-titre">Tarifs</h2>
    <p class="lancement">{offreLancement}</p>

    <div class="carte devis">
      <span class="pastille-icone"><Icone nom="devis" taille={24} /></span>
      <div>
        <h3>Déplacement et devis gratuits</h3>
        <p>Vous connaissez le prix total avant que je commence.</p>
      </div>
    </div>

    <div class="lecture">
      <p>
        <strong>Comment ça marche :</strong> je compte mon temps de travail à {tauxInstallation} de l'heure
        ({decompteTemps}). Le matériel (la prise, la lampe…) s'ajoute.
      </p>
      <p>
        Les temps ci-dessous sont des estimations, pour vous donner une idée. Exemple : remplacer une prise prend
        moins d'une heure, donc {tauxInstallation} + le prix de la prise. Plusieurs petits travaux le même jour ? Je
        compte le temps total, pas chaque travail.
      </p>
    </div>

    <div class="grilles">
      {interventionsInstallation.map(({ titre, lignes }) => <GrilleTarifs titre={titre} lignes={lignes} />)}
    </div>
    <p class="mention">{mentionTva}</p>
  </div>
</section>

<style>
  .devis {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-top: 1.5rem;
    border-top: 4px solid var(--jaune-soleil);
  }

  .devis .pastille-icone {
    flex: none;
    margin-bottom: 0;
  }

  .devis h3 {
    margin-bottom: 0.25rem;
  }

  .lecture {
    margin-block: 1.5rem;
    color: var(--gris-pierre);
  }

  .lecture p:last-child {
    margin-bottom: 0;
  }

  .grilles {
    display: grid;
    align-items: start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .mention {
    margin: 0;
    color: var(--gris-pierre);
    font-size: 0.9375rem;
  }

  @media (min-width: 48rem) {
    .grilles {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
</style>
