---
// Photos de chantiers de Corentin (sans élément permettant d'identifier l'adresse d'un client).
// WebP déjà compressés par Corentin (public/realisations/) : servis tels quels, sans recompression.
const photos = [
  { fichier: 'prises-plan-travail', legende: 'Prises sur le plan de travail d’une cuisine' },
  { fichier: 'prise-cuisine-double', legende: 'Double prise dans le mur de la cuisine' },
  { fichier: 'prise-salon-triple', legende: 'Triple prise dans un salon' },
  { fichier: 'interrupteur-telecommande', legende: 'Interrupteur double et télécommande murale' },
  { fichier: 'brasseur-air-allume', legende: 'Ventilateur de plafond avec éclairage' },
  { fichier: 'brasseur-air', legende: 'Ventilateur de plafond' },
];
---

<section class="section" aria-labelledby="realisations-titre">
  <div class="conteneur">
    <span class="surtitre">Réalisations</span>
    <h2 id="realisations-titre">Quelques chantiers récents</h2>
    <ul class="liste-nue galerie" role="list">
      {
        photos.map(({ fichier, legende }) => (
          <li>
            <figure>
              <img
                src={`/realisations/${fichier}.webp`}
                alt={legende}
                width="1920"
                height="1080"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{legende}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .galerie {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  figure {
    margin: 0;
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--rayon);
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--gris-pierre);
    font-size: 0.9375rem;
  }

  @media (min-width: 40rem) {
    .galerie {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .galerie {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
