---
// Chantiers d'installation, tirés de la rubrique Réalisations (src/data/chantiers.ts) : des cartes qui mènent
// à la page de chaque chantier. Remplace la galerie de photos du 29/10/2026 (demande de Corentin, 14/11/2026).
// Le récit d'un chantier n'est écrit que sur sa page : pas de texte en double, et des liens utiles à Google.
import CartesChantiers from '../realisations/CartesChantiers.astro';
import { chantiers } from '../../data/chantiers';

const chantiersInstallation = chantiers.filter((chantier) => chantier.installation);
---

<section class="section" aria-labelledby="realisations-titre">
  <div class="conteneur">
    <span class="surtitre">Réalisations</span>
    <h2 id="realisations-titre">Quelques chantiers récents</h2>
    <CartesChantiers chantiers={chantiersInstallation} niveau="h3" />
    <p class="lien-chantiers">
      <a href="/realisations/">Voir toutes mes réalisations</a>
    </p>
  </div>
</section>

<style>
  .lien-chantiers {
    margin: 2rem 0 0;
    font-weight: 700;
  }
</style>
