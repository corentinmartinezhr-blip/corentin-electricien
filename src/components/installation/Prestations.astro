---
// Prestations d'installation réellement proposées (illustrées par les réalisations de Corentin).
import Deroule from '../Deroule.astro';
import Icone from '../Icone.astro';

// Six familles pour rester lisible. Pas de VMC pour l'instant (choix de Corentin, 29/10/2026).
const prestations = [
  {
    icone: 'prise',
    titre: 'Prises et réseau',
    texte: 'Ajout, déplacement ou remplacement de prises et d’interrupteurs, prises RJ45 et TV.',
  },
  {
    icone: 'ampoule',
    titre: 'Éclairage intérieur et extérieur',
    texte:
      'Plafonniers, suspensions, ventilateurs de plafond, rubans LED, éclairage extérieur et détecteurs de présence.',
  },
  {
    icone: 'radiateur',
    titre: 'Chauffage électrique',
    texte: 'Pose et remplacement de radiateurs et de sèche-serviettes, thermostats et programmateurs.',
  },
  {
    icone: 'bouclier',
    titre: 'Sécurité et accès',
    texte: 'Détecteurs de fumée, interphones et visiophones.',
  },
  {
    icone: 'outils',
    titre: 'Circuits dédiés et tableau',
    texte: 'Tirage de câble et circuit dédié pour plaque, four ou lave-linge, remplacement du tableau électrique.',
  },
  {
    icone: 'voiture',
    titre: 'Prise pour véhicule électrique',
    // Prise renforcée ≤ 3,7 kW : pas de qualification IRVE requise. Jamais « borne de recharge ».
    texte: 'Prise renforcée au garage pour recharger votre voiture électrique ou hybride (jusqu’à 3,7 kW).',
  },
] as const;

const etapes = [
  'Vous m’expliquez votre projet, par téléphone ou sur WhatsApp avec quelques photos.',
  'Je vous remets un devis gratuit et détaillé avant les travaux.',
  'Je réalise les travaux proprement, à la date convenue ensemble.',
  'Je vérifie l’installation avec vous et je vous explique son fonctionnement.',
];
---

<section class="section" aria-labelledby="prestations-titre">
  <div class="conteneur">
    <span class="surtitre">Mes prestations</span>
    <h2 id="prestations-titre">Petits travaux et installation</h2>
    <ul class="liste-nue prestations" role="list">
      {
        prestations.map(({ icone, titre, texte }) => (
          <li class="carte">
            <span class="pastille-icone">
              <Icone nom={icone} taille={24} />
            </span>
            <h3>{titre}</h3>
            <p>{texte}</p>
          </li>
        ))
      }
    </ul>

    <Deroule titre="Comment se passent les travaux" etapes={etapes} />
  </div>
</section>

<style>
  .prestations {
    display: grid;
    gap: 1rem;
    margin-block: 2rem 3rem;
  }

  .prestations h3 {
    font-size: 1.125rem;
  }

  @media (min-width: 40rem) {
    .prestations {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .prestations {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
