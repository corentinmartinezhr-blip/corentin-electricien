---
// Prestations d'installation réellement proposées (illustrées par les réalisations de Corentin).
import Deroule from '../Deroule.astro';
import Icone from '../Icone.astro';

// Six familles pour rester lisible. Pas de VMC pour l'instant (choix de Corentin, 29/10/2026).
const prestations = [
  {
    icone: 'prise',
    titre: 'Prises et interrupteurs',
    texte: 'J’ajoute, je déplace ou je change vos prises et interrupteurs, ainsi que les prises internet (RJ45) et TV.',
  },
  {
    icone: 'ampoule',
    titre: 'Éclairage intérieur et extérieur',
    texte:
      'Lampes au plafond, suspensions, ventilateurs de plafond, bandes de LED, lumières dehors et lumières qui s’allument quand on passe.',
  },
  {
    icone: 'radiateur',
    titre: 'Chauffage électrique',
    texte: 'J’installe ou je change vos radiateurs et sèche-serviettes, et les boîtiers qui règlent la température.',
  },
  {
    icone: 'bouclier',
    titre: 'Sécurité et accès',
    texte: 'Détecteurs de fumée, interphones et interphones avec caméra (visiophones).',
  },
  {
    icone: 'outils',
    titre: 'Nouvelles lignes et tableau',
    texte: 'Une ligne électrique rien que pour votre plaque de cuisson, votre four ou votre lave-linge. Remplacement du tableau électrique.',
  },
  {
    icone: 'voiture',
    titre: 'Prise pour voiture électrique',
    // Prise renforcée ≤ 3,7 kW : pas de qualification IRVE requise. Jamais « borne de recharge ».
    texte: 'Une prise renforcée (plus solide qu’une prise normale) au garage, pour recharger votre voiture électrique ou hybride (jusqu’à 3,7 kW).',
  },
] as const;

const etapes = [
  'Vous m’expliquez votre projet, par téléphone ou sur WhatsApp avec quelques photos.',
  'Je vous remets un devis gratuit et détaillé avant les travaux.',
  'Je réalise les travaux proprement, à la date convenue ensemble.',
  'Je vérifie avec vous que tout marche et je vous montre comment l’utiliser.',
];
---

<section class="section" aria-labelledby="prestations-titre">
  <div class="conteneur">
    <span class="surtitre">Mes prestations</span>
    <h2 id="prestations-titre">Petits travaux et installation</h2>
    <ul class="liste-nue prestations" role="list">
      {
        prestations.map(({ icone, titre, texte }) => (
          <li class="carte">
            <span class="pastille-icone">
              <Icone nom={icone} taille={24} />
            </span>
            <h3>{titre}</h3>
            <p>{texte}</p>
          </li>
        ))
      }
    </ul>

    <Deroule titre="Comment se passent les travaux" etapes={etapes} />
  </div>
</section>

<style>
  .prestations {
    display: grid;
    gap: 1rem;
    margin-block: 2rem 3rem;
  }

  .prestations h3 {
    font-size: 1.125rem;
  }

  @media (min-width: 40rem) {
    .prestations {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .prestations {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
</style>
