---
// Coordonnées directes, pour ceux qui préfèrent ne pas passer par le formulaire.
import BoutonContact from '../BoutonContact.astro';
import NumeroCopiable from '../NumeroCopiable.astro';
import { entreprise } from '../../data/entreprise';
---

<aside class="carte coordonnees" aria-labelledby="coordonnees-titre">
  <h2 id="coordonnees-titre">Me joindre directement</h2>
  <dl>
    <dt>Téléphone et WhatsApp</dt>
    <dd><NumeroCopiable /></dd>
    <dt>E-mail</dt>
    <dd><a href={`mailto:${entreprise.email}`}>{entreprise.email}</a></dd>
    <dt>Adresse</dt>
    <dd>{entreprise.adresse.rue}, {entreprise.adresse.codePostal} {entreprise.adresse.ville}</dd>
    <dt>Zone d'intervention</dt>
    <dd>{entreprise.ville} et les <a href="/#zone-titre">communes voisines</a></dd>
  </dl>
  <div class="coordonnees__actions">
    <BoutonContact action="appel" variante="principal" />
    <BoutonContact action="whatsapp" />
  </div>
  <p class="coordonnees__langues">Je parle aussi anglais. <span lang="en">I also speak English.</span></p>
</aside>

<style>
  .coordonnees {
    align-self: start;
  }

  dl {
    margin: 1rem 0 1.5rem;
  }

  dt {
    color: var(--gris-pierre);
    font-size: 0.875rem;
  }

  dd {
    margin: 0 0 1rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .coordonnees__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .coordonnees__langues {
    margin: 1rem 0 0;
    color: var(--gris-pierre);
    font-size: 0.9375rem;
  }
</style>
