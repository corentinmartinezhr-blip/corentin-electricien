---
// Haut de page des pages intérieures (Dépannage, Installation…) :
// fil d'Ariane, surtitre, H1, accroche, boutons et image facultative à droite.
// Image : soit un fichier de src/assets (optimisé par Astro), soit le chemin d'un WebP
// déjà compressé par Corentin dans public/ (servi tel quel, sans recompression).
// Chemin simple = WebP de 1920 × 1080 (public/realisations/). Photo de chantier = objet { dossier, fichier, largeur,
// hauteur } : ses vraies dimensions, et la version 960 px pour les téléphones (page plus légère, affichage plus rapide).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BoutonContact from './BoutonContact.astro';

interface PhotoChantier {
  dossier: string;
  fichier: string;
  largeur: number;
  hauteur: number;
}

interface Props {
  surtitre: string;
  titre: string;
  image?: ImageMetadata | string | PhotoChantier;
  alt?: string;
  /** Page parente dans le fil d'Ariane (ex. Réalisations pour la page d'un chantier). */
  parent?: { texte: string; url: string };
}

const { surtitre, titre, image, alt = '', parent } = Astro.props;
const photo = image && typeof image === 'object' && 'fichier' in image ? image : undefined;
// Largeur affichée : la colonne de droite sur ordinateur, presque tout l'écran sur téléphone.
const tailles = '(min-width: 48rem) 28rem, 90vw';

// Le même fil d'Ariane, lisible par Google (il peut l'afficher sous le titre dans ses résultats).
const niveaux = [
  { name: 'Accueil', item: new URL('/', Astro.site).href },
  ...(parent ? [{ name: parent.texte, item: new URL(parent.url, Astro.site).href }] : []),
  { name: surtitre },
];
const filAriane = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: niveaux.map((niveau, index) => ({ '@type': 'ListItem', position: index + 1, ...niveau })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(filAriane)} />

<section class="intro-page" aria-labelledby="intro-titre">
  <div class:list={['conteneur', { 'intro-page__grille': image }]}>
    <div>
      <nav class="fil" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a> <span aria-hidden="true">›</span>
        {parent && (
          <>
            <a href={parent.url}>{parent.texte}</a> <span aria-hidden="true">›</span>
          </>
        )}
        <span aria-current="page">{surtitre}</span>
      </nav>
      <span class="surtitre">{surtitre}</span>
      <h1 id="intro-titre">{titre}</h1>
      <div class="intro-page__texte"><slot /></div>
      <div class="intro-page__actions">
        <BoutonContact action="appel" variante="principal" />
        <BoutonContact action="whatsapp" />
      </div>
    </div>
    {
      typeof image === 'string' && (
        <img
          class="intro-page__image"
          src={image}
          alt={alt}
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    {
      photo && (
        <img
          class="intro-page__image"
          src={`${photo.dossier}/${photo.fichier}-960.webp`}
          srcset={`${photo.dossier}/${photo.fichier}-960.webp 960w, ${photo.dossier}/${photo.fichier}.webp 1920w`}
          sizes={tailles}
          alt={alt}
          width={photo.largeur}
          height={photo.hauteur}
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    {
      image && typeof image === 'object' && !photo && (
        <Image
          class="intro-page__image"
          src={image as ImageMetadata}
          alt={alt}
          width={900}
          widths={[400, 600, 900]}
          sizes={tailles}
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </div>
</section>

<style>
  .intro-page {
    padding-block: clamp(2rem, 6vw, 4rem);
    background: var(--vert-brume);
  }

  .intro-page__grille {
    display: grid;
    align-items: center;
    gap: 2.5rem;
  }

  .fil {
    margin-bottom: 1.5rem;
    color: var(--gris-pierre);
    font-size: 0.875rem;
  }

  h1 {
    max-width: 22ch;
    font-size: clamp(2rem, 5.5vw, 3rem);
  }

  .intro-page__texte {
    max-width: 40rem;
    margin-bottom: 1.75rem;
    font-size: 1.125rem;
  }

  .intro-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .intro-page__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1.25rem;
  }

  @media (max-width: 29.99rem) {
    .intro-page__actions :global(.bouton) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 48rem) {
    .intro-page__grille {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 3rem;
    }
  }
</style>
