---
// Petites icônes en SVG inline (aucune bibliothèque, rien à télécharger).
interface Props {
  nom: 'telephone' | 'whatsapp' | 'eclair' | 'outils' | 'electromenager' | 'devis' | 'prise' | 'ampoule' | 'voiture' | 'radiateur' | 'bouclier';
  taille?: number;
}
const { nom, taille = 20 } = Astro.props;
---

<svg
  class="icone"
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {nom === 'telephone' && (
    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
  )}
  {nom === 'whatsapp' && (
    <>
      <path d="M3 21l1.6-4.8A9 9 0 1 1 8 19.5z" />
      <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2z" />
    </>
  )}
  {nom === 'eclair' && <path d="M13 2 4 14h7l-1 8 9-12h-7z" />}
  {nom === 'outils' && (
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z" />
  )}
  {nom === 'electromenager' && (
    <>
      <rect x="4" y="2" width="16" height="20" rx="2" />
      <circle cx="12" cy="13" r="4.5" />
      <path d="M8 5.5h.01M11 5.5h.01" />
    </>
  )}
  {nom === 'prise' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <circle cx="12" cy="12" r="5" />
      <path d="M10 12h.01M14 12h.01" />
    </>
  )}
  {nom === 'ampoule' && (
    <>
      <path d="M9 18h6M10 22h4" />
      <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z" />
    </>
  )}
  {nom === 'voiture' && (
    <>
      <path d="M5 17H3v-5l2-5h11l3 5h2v5h-2" />
      <circle cx="7.5" cy="17" r="2" />
      <circle cx="16.5" cy="17" r="2" />
      <path d="M9.5 17h5M12 7l-1.5 3h3L12 13" />
    </>
  )}
  {nom === 'radiateur' && (
    <>
      <rect x="3" y="5" width="18" height="13" rx="2" />
      <path d="M7.5 5v13M12 5v13M16.5 5v13M6 18v2M18 18v2" />
    </>
  )}
  {nom === 'bouclier' && (
    <>
      <path d="M12 2 4 5v6c0 5 3.4 9.3 8 11 4.6-1.7 8-6 8-11V5z" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}
  {nom === 'devis' && (
    <>
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
      <path d="M14 2v6h6M9 13h6M9 17h6" />
    </>
  )}
</svg>

<style>
  .icone {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
