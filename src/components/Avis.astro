---
// Avis Google (accueil et page Dépannage) : chaque page choisit ses avis (données : src/data/avis.ts).
// La sélection est dite en clair sous les avis, avec la note moyenne et un lien vers tous les avis :
// obligatoire (Code de la consommation), et c'est plus honnête. Rien ne s'affiche tant qu'il n'y a aucun avis.
// Pas de données structurées « avis » : Google ne montre pas d'étoiles pour les avis affichés par l'entreprise elle-même.
import { bilan, type Avis } from '../data/avis';
import { entreprise } from '../data/entreprise';

interface Props {
  liste: Avis[];
  titre?: string;
  /** Comment les avis ont été choisis, dit en clair au lecteur. */
  selection?: string;
  /** Fond vert brume, pour alterner avec les sections voisines. */
  brume?: boolean;
}

const {
  liste,
  titre = 'Ce que disent mes clients',
  selection = 'Ici, une sélection de mes avis 5 étoiles, recopiés sans retouche.',
  brume = false,
} = Astro.props;

const dateLisible = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
const noteLisible = bilan.note.toLocaleString('fr-FR', { maximumFractionDigits: 1 });
---

{
  liste.length > 0 && (
    <section class:list={['section', { 'section--brume': brume }]} aria-labelledby="avis-titre">
      <div class="conteneur">
        <span class="surtitre">Avis Google</span>
        <h2 id="avis-titre">{titre}</h2>
        <ul class="liste-nue avis" role="list">
          {liste.map((un) => (
            <li class="carte un-avis">
              <figure>
                <p class="etoiles" role="img" aria-label={`${un.note} étoiles sur 5`}>
                  {'★'.repeat(un.note)}
                </p>
                <blockquote>
                  {un.texte.split('\n\n').map((paragraphe) => <p>{paragraphe}</p>)}
                </blockquote>
                <figcaption>
                  <strong>{un.auteur}</strong>, <time datetime={un.date}>{dateLisible(un.date)}</time>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="avis__bilan">
          Note de {noteLisible}/5 sur {bilan.nombre} avis Google. {selection}{' '}
          <a href={entreprise.ficheGoogle} rel="noopener">Voir tous mes avis sur Google</a>
        </p>
      </div>
    </section>
  )
}

<style>
  /* Trois cartes côte à côte sur ordinateur ; centrées s'il y en a moins de trois. */
  .avis {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .un-avis {
    flex: 1 1 18rem;
    max-width: 24rem;
    border-top: 4px solid var(--jaune-soleil);
  }

  figure {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
  }

  .etoiles {
    margin: 0 0 0.75rem;
    color: var(--ocre);
    font-size: 1.25rem;
    letter-spacing: 0.15em;
  }

  blockquote {
    margin: 0 0 1rem;
  }

  /* pre-line : garde les retours à la ligne de l'avis, comme sur Google. */
  blockquote p {
    margin: 0;
    white-space: pre-line;
  }

  blockquote p + p {
    margin-top: 0.75rem;
  }

  figcaption {
    margin-top: auto;
    color: var(--gris-pierre);
    font-size: 0.9375rem;
  }

  figcaption strong {
    color: var(--vert-olive);
  }

  .avis__bilan {
    max-width: 44rem;
    margin: 1.75rem auto 0;
    color: var(--gris-pierre);
    font-size: 0.9375rem;
    text-align: center;
  }

  .avis__bilan a {
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .avis {
      gap: 1.5rem;
    }
  }
</style>
