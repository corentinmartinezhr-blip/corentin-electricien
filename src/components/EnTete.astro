---
// En-tête : logo à gauche ; à droite, le menu puis le bouton d'appel.
import Icone from './Icone.astro';
import { entreprise } from '../data/entreprise';
import { menu } from '../data/navigation';

const cheminActuel = Astro.url.pathname;
---

<header class="en-tete">
  <div class="conteneur en-tete__grille">
    <a class="en-tete__logo" href="/" aria-label={`${entreprise.nom}, accueil`}>
      <img src="/logo/logo-horizontal.svg" alt="" width="1188" height="500" />
    </a>
    <nav class="en-tete__nav" aria-label="Menu principal">
      <ul class="liste-nue en-tete__menu" role="list">
        {
          menu.map(({ url, texte }) => (
            <li>
              <a href={url} aria-current={cheminActuel.startsWith(url) ? 'page' : undefined}>
                {texte}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a
      class="bouton bouton--principal en-tete__appel"
      href={entreprise.telephoneLien}
      data-numero={entreprise.telephoneAffiche}
    >
      <Icone nom="telephone" taille={18} />
      {entreprise.telephoneAffiche}
    </a>
  </div>
</header>

<style>
  .en-tete {
    border-bottom: 1px solid var(--bordure);
    background: var(--ivoire);
  }

  /* Mobile : logo et bouton d'appel sur la 1re ligne, menu sur la 2e. */
  .en-tete__grille {
    display: grid;
    grid-template-areas:
      'logo appel'
      'nav nav';
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.75rem;
  }

  .en-tete__logo {
    grid-area: logo;
  }

  .en-tete__logo img {
    width: clamp(7rem, 30vw, 11.5rem);
  }

  .en-tete__nav {
    grid-area: nav;
    margin-top: 0.5rem;
  }

  .en-tete__menu {
    display: flex;
    gap: 1.5rem;
  }

  .en-tete__menu a {
    display: inline-block;
    padding-block: 0.4rem;
    font-weight: 700;
    text-decoration: none;
  }

  .en-tete__menu a:hover,
  .en-tete__menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--jaune-soleil);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  /* Le numéro est écrit sur le bouton : on peut le lire ou le recopier, et le clic garde son effet
     (appel sur téléphone, copie sur ordinateur). */
  .en-tete__appel {
    grid-area: appel;
    min-height: 2.75rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  /* Très petits écrans : l'icône s'efface pour que le numéro tienne à côté du logo. */
  @media (max-width: 22rem) {
    .en-tete__appel :global(svg) {
      display: none;
    }
  }

  /* Ordinateur : tout sur une ligne, menu juste à gauche du bouton. */
  @media (min-width: 48rem) {
    .en-tete__grille {
      grid-template-areas: 'logo nav appel';
      grid-template-columns: 1fr auto auto;
      column-gap: 1.75rem;
      min-height: 4.5rem;
      padding-block: 0;
    }

    .en-tete__nav {
      margin-top: 0;
    }

    .en-tete__appel {
      padding-inline: 1.1rem;
      font-size: 0.9375rem;
    }
  }
</style>
