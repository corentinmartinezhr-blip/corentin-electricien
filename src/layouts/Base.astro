---
// Gabarit commun à toutes les pages : <head> (SEO, polices), en-tête, pied de page.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/manrope';
import '../styles/global.css';
// Préchargement des polices latines (titres et texte) pour un affichage plus rapide.
import policeTitres from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import policeTexte from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { communes, entreprise } from '../data/entreprise';

interface Props {
  /** Balise <title> : ~60 caractères maximum, mot-clé principal en premier. */
  title: string;
  /** Meta description : ~155 caractères maximum. */
  description: string;
  /** false pour les pages utilitaires (merci, erreur) : jamais indexées, absentes du sitemap. */
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;

// Tant que le site n'est pas lancé officiellement, il est en « noindex ».
// Seul le lancement passera PUBLIC_SITE_ENV à « production » (voir .github/workflows/publier.yml).
const estProduction = import.meta.env.PUBLIC_SITE_ENV === 'production';
const urlCanonique = new URL(Astro.url.pathname, Astro.site).href;

// Données structurées : uniquement des informations exactes et publiques.
// Le SIRET sera ajouté quand il existera.
const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: entreprise.nom,
  url: Astro.site?.href,
  telephone: entreprise.telephoneInternational,
  knowsLanguage: entreprise.langues,
  address: {
    '@type': 'PostalAddress',
    streetAddress: entreprise.adresse.rue,
    postalCode: entreprise.adresse.codePostal,
    addressLocality: entreprise.adresse.ville,
    addressCountry: 'FR',
  },
  image: new URL('/logo/logo-carre.svg', Astro.site).href,
  areaServed: communes.map((commune) => ({ '@type': 'City', name: commune })),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    {(!estProduction || !indexable) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={entreprise.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />

    <link rel="preload" href={policeTitres} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={policeTexte} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#FAF7F0" /><!-- = --ivoire (une balise meta ne lit pas le CSS) -->
    <meta name="format-detection" content="telephone=no" />

    <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <EnTete />
    <main id="contenu">
      <slot />
    </main>
    <PiedDePage />
    <script>
      import '../scripts/contact.ts';
    </script>
  </body>
</html>
