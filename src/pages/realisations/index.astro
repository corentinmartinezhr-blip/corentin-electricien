---
// Catalogue des chantiers : /realisations/. Une carte par chantier, chacun avec sa page détaillée.
// Pour ajouter un chantier : une page dans src/pages/realisations/ et une entrée dans src/data/chantiers.ts.
// Pas de haut de page avec photo (demande de Corentin, 02/11/2026) : le titre, puis directement les chantiers.
import Base from '../../layouts/Base.astro';
import AppelFinal from '../../components/AppelFinal.astro';
import { entreprise } from '../../data/entreprise';
import CartesChantiers from '../../components/realisations/CartesChantiers.astro';
import { chantiers } from '../../data/chantiers';
---

<Base
  title={`Réalisations : chantiers en photos à ${entreprise.ville} | Corentin`}
  description={`Mes chantiers d'électricien à ${entreprise.ville}, racontés étape par étape et en photos : ce que j'ai fait, comment et pourquoi.`}
>
  <section class="section" aria-labelledby="chantiers-titre">
    <div class="conteneur">
      <h1 id="chantiers-titre">Mes réalisations d'électricien à {entreprise.ville}</h1>
      <CartesChantiers chantiers={chantiers} prioritaires />
    </div>
  </section>

  <AppelFinal titre={'Un projet ?'} devis>
    <p>Appelez-moi, écrivez-moi sur WhatsApp ou demandez un devis gratuit. Je réponds {entreprise.horaires}.</p>
  </AppelFinal>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 5.5vw, 3rem);
  }
</style>
