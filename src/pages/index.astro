---
// Page d'accueil : chaque section est un composant de src/components/accueil/.
// Alternance des fonds : brume (hero), ivoire (services), brume (qui suis-je), ivoire (avis), brume (garanties),
// ivoire (zone), brume (FAQ), puis olive. Les avis s'affichent dès le premier avis (src/data/avis.ts).
import Base from '../layouts/Base.astro';
import Hero from '../components/accueil/Hero.astro';
import Services from '../components/accueil/Services.astro';
import Presentation from '../components/accueil/Presentation.astro';
import Avis from '../components/accueil/Avis.astro';
import Garanties from '../components/accueil/Garanties.astro';
import Zone from '../components/accueil/Zone.astro';
import Faq from '../components/accueil/Faq.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { entreprise } from '../data/entreprise';
---

<Base
  title="Électricien d'urgence à Avignon | Corentin Électricien"
  description={`Dépannage électrique en urgence à Avignon, Le Pontet, Villeneuve-lès-Avignon et Les Angles : ${entreprise.horairesCourts}, ${entreprise.deplacement}. Appel ou WhatsApp.`}
>
  <Hero />
  <Services />
  <Presentation />
  <Avis />
  <Garanties />
  <Zone />
  <Faq />
  <AppelFinal />
</Base>
