---
// Page affichée quand envoyer.php refuse ou ne peut pas envoyer la demande.
// envoyer.php ajoute une ancre (#telephone, #email…) : le CSS (:target) n'affiche alors que l'explication
// du champ en cause. Sans ancre, toutes les explications restent visibles. Aucun JavaScript.
import Base from '../../layouts/Base.astro';
import IntroPage from '../../components/IntroPage.astro';

const motifs = [
  { id: 'nom', texte: 'Le prénom et le nom doivent être remplis.' },
  { id: 'telephone', texte: 'Le téléphone doit contenir 10 chiffres, par exemple 06 12 34 56 78.' },
  { id: 'email', texte: "L'adresse e-mail doit être complète, par exemple nom@exemple.fr." },
  { id: 'type', texte: 'Choisissez le type de demande (dépannage, électroménager…).' },
  { id: 'message', texte: 'Votre message doit faire au moins 10 caractères.' },
  {
    id: 'photos',
    texte: 'Les photos doivent respecter les limites : 3 maximum, 8 Mo chacune, au format JPEG, PNG, WebP ou HEIC.',
  },
  { id: 'envoi', texte: "L'envoi a échoué de mon côté, ce n'est pas votre faute. Réessayez dans quelques minutes." },
];
---

<Base title="Demande non envoyée | Corentin Électricien" description="Votre demande n'a pas pu être envoyée." indexable={false}>
  <IntroPage surtitre="Contact" titre="Votre demande n'a pas pu être envoyée">
    <ul class="motifs liste-nue" role="list">
      {motifs.map(({ id, texte }) => <li id={id}>{texte}</li>)}
    </ul>
    <p>
      Revenez en arrière avec le bouton « Retour » de votre navigateur pour corriger (vos réponses sont
      généralement conservées, les photos sont à rajouter), ou <a href="/contact/">recommencez le formulaire</a>.
      Vous pouvez aussi m'appeler ou m'écrire sur WhatsApp.
    </p>
  </IntroPage>
</Base>

<style>
  .motifs {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .motifs li {
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--ocre);
    background: var(--ivoire);
    font-weight: 700;
    scroll-margin-top: 100vh; /* l'ancre ne fait pas défiler la page : le titre reste visible */
  }

  /* Une ancre désigne le champ en cause : on n'affiche que lui. */
  .motifs:has(:target) li:not(:target) {
    display: none;
  }
</style>
