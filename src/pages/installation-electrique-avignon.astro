---
// Page Installation : /installation-electrique-avignon/ (recherches visées : « installation électrique Avignon »,
// « pose luminaire Avignon », « installation prise électrique Avignon »).
// Ordre demandé par Corentin : tarifs avant les réalisations.
// Alternance des fonds : brume, ivoire, brume (tarifs), ivoire (réalisations), puis olive.
import Base from '../layouts/Base.astro';
import IntroPage from '../components/IntroPage.astro';
import Prestations from '../components/installation/Prestations.astro';
import Realisations from '../components/installation/Realisations.astro';
import Tarifs from '../components/installation/Tarifs.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { entreprise } from '../data/entreprise';
---

<Base
  title="Installation électrique à Avignon – Tarifs | Corentin Électricien"
  description="Prises, éclairage, radiateurs, détecteurs de fumée, interphone, circuits dédiés, prise véhicule électrique à Avignon. Tarifs affichés, devis gratuit."
>
  <IntroPage
    surtitre="Installation électrique"
    titre={`Installation électrique à ${entreprise.ville} et alentours`}
    image="/realisations/cuisine-prises-led.webp"
    alt="Cuisine équipée de prises et d'un éclairage LED sous les meubles, posés par Corentin"
  >
    <p>
      Prises, éclairage, chauffage électrique, détecteurs de fumée ou prise pour voiture électrique : je réalise
      vos petits travaux avec soin, avec des tarifs affichés et un devis gratuit avant de commencer.
    </p>
  </IntroPage>
  <Prestations />
  <Tarifs />
  <Realisations />
  <AppelFinal />
</Base>
