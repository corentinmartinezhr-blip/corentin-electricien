---
// Page Dépannage : /depannage-electrique-avignon/ (recherches visées : « dépannage électrique urgence Avignon »,
// « électricien urgence Avignon », « recherche de panne électrique Avignon »).
// Positionnement du 30/10/2026 : dépannage d'urgence, 7j/7 de 7h à 22h, moins de 24 h, à vélo électrique.
// Ordre voulu par Corentin : haut de page, tarifs, pannes, électroménager, bons réflexes, puis la FAQ urgence.
import Base from '../layouts/Base.astro';
import IntroPage from '../components/IntroPage.astro';
import Pannes from '../components/depannage/Pannes.astro';
import Tarif from '../components/depannage/Tarif.astro';
import Electromenager from '../components/depannage/Electromenager.astro';
import BonsReflexes from '../components/depannage/BonsReflexes.astro';
import FaqUrgence from '../components/depannage/FaqUrgence.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { entreprise } from '../data/entreprise';
import { offreDepannage } from '../data/tarifs';
import photoTableau from '../assets/realisations/tableau-electrique.png';
---

<Base
  title="Dépannage électrique en urgence à Avignon | Corentin"
  description={`Électricien d'urgence à Avignon, ${entreprise.horairesCourts} : sur place en moins de 24 h, ${entreprise.deplacement}. Déplacement et devis gratuits, ${offreDepannage.prix} TTC/h.`}
>
  <IntroPage
    surtitre="Dépannage électrique d'urgence"
    titre={`Dépannage électrique en urgence à ${entreprise.ville}`}
    image={photoTableau}
    alt={`Tableau électrique remis en état par Corentin, électricien à ${entreprise.ville}`}
  >
    <p>
      Plus de courant, un disjoncteur qui saute, une prise qui ne marche plus ? J'arrive {entreprise.deplacement},
      {entreprise.delai}. {entreprise.delaiRapide}
    </p>
    <p>
      <strong>
        {entreprise.horaires}. Déplacement et devis gratuits, puis {offreDepannage.prix}
        {offreDepannage.unite}. {offreDepannage.promesse}
      </strong>
    </p>
  </IntroPage>
  <Tarif />
  <Pannes />
  <Electromenager />
  <BonsReflexes />
  <FaqUrgence />
  <AppelFinal />
</Base>
